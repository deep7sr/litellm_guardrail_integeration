# Copy to .env and fill in. Never commit .env.

# Required
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
GROQ_API_KEY=

# Judge (defaults target the local vLLM service)
JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
JUDGE_BASE_URL=http://vllm-judge:8000/v1
JUDGE_API_KEY=not-needed-for-local-vllm
HUGGING_FACE_HUB_TOKEN=

# Dev-only alternative: use Groq as the judge while no GPU is available.
# llama-3.1-8b-instant is verified working (24/24 on the accuracy benchmark,
# tests/eval_scorer_accuracy.py). openai/gpt-oss-20b is NOT recommended: it
# has a documented Groq tool-calling bug (community.groq.com/t/406) that
# surfaces as scorer_error_blocked in production.
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL=llama-3.1-8b-instant
# JUDGE_API_KEY= same value as GROQ_API_KEY above (plain value, not ${...} —
#                .env files don't expand references to other .env vars)

# Guardrail policy
RAGAS_PASS_THRESHOLD=0.7
RAGAS_MAX_RETRIES=2
RAGAS_ON_SCORER_ERROR=block      # block | allow
RAGAS_SCORING_TIMEOUT_S=60
JUDGE_STRUCTURED_MODE=json       # json (recommended) | tools
