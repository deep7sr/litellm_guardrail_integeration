# Copy to .env and fill in. Anything left unset falls back to the insecure
# dev defaults baked into the compose files — fine on a laptop, NOT on the VM.

# --- Existing stack ---
GROQ_API_KEY=
LITELLM_MASTER_KEY=sk-1234

# --- Langfuse (docker-compose.langfuse.yml) ---
# API keypair provisioned at first boot via LANGFUSE_INIT_*; the proxy's
# callback and the eval runner both use it.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
# UI login created at first boot
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
# Infra secrets — generate: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PG_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- Eval runner ---
# DEDICATED LiteLLM virtual key with max_budget + rpm limit (NOT the master
# key). Create it after the proxy is up — see docs/EVALS_SETUP.md step 4.
EVAL_PROXY_API_KEY=
