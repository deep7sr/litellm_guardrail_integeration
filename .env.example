# Copy to .env and fill in. Never commit .env.

# Required
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
GROQ_API_KEY=

# Judge (defaults target the local vLLM service)
JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
JUDGE_BASE_URL=http://vllm-judge:8000/v1
JUDGE_API_KEY=not-needed-for-local-vllm
HUGGING_FACE_HUB_TOKEN=

# Dev-only alternative: use Groq as the judge while no GPU is available
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL=openai/gpt-oss-20b
# JUDGE_API_KEY=${GROQ_API_KEY}

# Guardrail policy
RAGAS_PASS_THRESHOLD=0.7
RAGAS_MAX_RETRIES=2
# prompt (default) = fully transparent: requests without explicit context are
#   grounded against the whole conversation (catches model fabrication).
# block = strict: reject requests missing metadata.guardrail_context (400).
# skip  = let context-less requests through unscored (not recommended).
RAGAS_ON_MISSING_CONTEXT=prompt
RAGAS_ON_SCORER_ERROR=block      # block | allow
RAGAS_SCORING_TIMEOUT_S=60
